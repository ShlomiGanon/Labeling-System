# =============================================================
# Labeling System - Environment Configuration
# =============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git!
# =============================================================

# --- Security ---
# Generate a strong random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# --- Server ---
# Set to false in production!
DEBUG=false
PORT=5000

# --- CORS ---
# In production, Flask serves the frontend directly (same origin) so CORS is not needed.
# Uncomment the line below only if you need to allow an extra origin (e.g. for testing):
# ALLOWED_ORIGIN=https://labeling.your-company.com
